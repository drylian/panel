{
   "compilerOptions": {
     "target": "ESNext",
     "lib": ["ESNext", "DOM"],
     "module": "CommonJS",
     "baseUrl": ".",
     "outDir": "dist/",
     "resolveJsonModule": true,
     "declaration": true,
     "declarationMap": true,
     "useDefineForClassFields": true,
     "removeComments": true,
     "esModuleInterop": true,
     "forceConsistentCasingInFileNames": true,
     "strict": true,
     "skipLibCheck": true
   },
   "include": ["./src/**/*"],
   "exclude": ["node_modules/*", "dist/*"]
 }